import ../Common.buildvars

Assembly                 &FileName
Type                     static_lib

Compiler.Includes        .. ../Build
Compiler.Includes.Export .. ../Build

# The compute backend gates Jolt's own public headers, so consumers need it too
if renderer == dx12   Compiler.Defines(export) JPH_USE_DX12
if renderer == vulkan Compiler.Defines(export) JPH_USE_VK

Assert.WorkingDirectory  .
Assert.Architecture      x86 x64 arm arm64

Assert.CPU.Extensions:x86   sse2
Assert.CPU.Extensions:arm64 neon fp16
