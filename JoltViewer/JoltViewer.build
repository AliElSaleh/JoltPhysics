import ../Common.buildvars

Assembly &FileName
.run     | ..

Compiler.Includes . .. ../TestFramework

DxLibraries d3d12 dxguid dinput8 dxgi d3dcompiler
Libraries &NativeLibs $DxLibraries

Linker.Subsystem console

Depends ../Jolt          | &args
Depends ../TestFramework | &args

Assert.Platform Windows
Platform.*.errormessage
{
    JoltViewer currently does not support &(platform). It is a Windows only application at this time.
}
